  // TrustServerCertificate=true avoids certificate errors on dev machines.
  "ConnectionStrings": {
    "CareBridgeDB": "Server=(local);Database=CareBridgeDB;Integrated Security=true;TrustServerCertificate=true;"
  },


  // ── Azure Service Bus ───────────────────────────────────────────────
  // Paste the Primary Connection String from Section 4.4 below.
  // The TopicName must match exactly what you created in the Azure portal.
  
  }
